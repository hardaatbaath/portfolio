# ============================================================================
#  Copy this file to `.env.local` and fill in your values.
#  `.env.local` is git-ignored and never committed.
#
#  NEXT_PUBLIC_* values are safe to expose to the browser (they end up in the
#  bundle). Everything else is server-only (never sent to the client).
#
#  On Vercel: add these under Project → Settings → Environment Variables.
# ============================================================================

# --- Identity & links (all optional — sensible defaults live in site.config.ts)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_NAME="Hardaat Singh Baath"
NEXT_PUBLIC_EMAIL="you@example.com"
NEXT_PUBLIC_RESUME_URL="/Hardaat-Singh-Baath-Resume.pdf"

# --- Social / feed handles (drive auto-fetched blogs + links) ---------------
NEXT_PUBLIC_GITHUB_USERNAME="hardaatbaath"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/your-handle"
NEXT_PUBLIC_SCHOLAR_URL="https://scholar.google.com/citations?user=XXXX"
NEXT_PUBLIC_TWITTER_URL="https://x.com/your-handle"   # leave blank to hide the X icon
NEXT_PUBLIC_DEVTO_USERNAME="your-devto-username"
NEXT_PUBLIC_SUBSTACK_URL="https://your-name.substack.com"

# --- Contact form (Resend) --- server-only secrets --------------------------
# Get a key at https://resend.com/api-keys  (see docs/03-resend-email.md)
RESEND_API_KEY=""
# Where contact-form messages are delivered:
CONTACT_EMAIL="you@example.com"
# Optional: after verifying your domain in Resend, the "from" address.
# Leave unset to use Resend's shared onboarding@resend.dev sender.
CONTACT_FROM="Hardaat <hi@hardaatsinghbaath.com>"

# --- Analytics (optional) ---------------------------------------------------
# Google Analytics 4 measurement id, e.g. "G-XXXXXXXXXX". Leave blank to disable.
NEXT_PUBLIC_GA_ID=""
